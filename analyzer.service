[Unit]
Description=Chess Game Analyzer - Stockfish analysis worker
After=network.target postgresql.service docker.service
Wants=postgresql.service docker.service

[Service]
Type=simple
User=chess
Group=chess
WorkingDirectory=/opt/chess-rest-api
ExecStartPre=/bin/bash -c 'test -d /opt/chess-rest-api/venv || python3 -m venv /opt/chess-rest-api/venv && /opt/chess-rest-api/venv/bin/pip install -r /opt/chess-rest-api/requirements.txt'
ExecStart=/opt/chess-rest-api/venv/bin/python3 /opt/chess-rest-api/analyzer.py --listen
EnvironmentFile=/opt/chess-rest-api/.env
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
